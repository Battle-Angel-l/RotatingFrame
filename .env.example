DISCORD_TOKEN=your_discord_bot_token_here
# Optional: a guild id for faster slash command sync during development.
DISCORD_GUILD_ID=

# Auto-posting channel configuration. Can also be set with slash commands.
ROTATIONS_CHANNEL_ID=
ROTATIONS_MESSAGE_ID=

# How often the pinned rotation message is refreshed.
UPDATE_INTERVAL_MINUTES=5

# Weekly reset anchor dates (UTC Monday 00:00) for week 1.
# If you notice week mismatch, adjust these.
CIRCUIT_NORMAL_EPOCH=2023-05-01
CIRCUIT_STEEL_EPOCH=2023-06-05

# Coda weapons rotate every 4 days at 00:00 UTC.
# Week-agnostic anchor date used for timer fallback.
CODA_EPOCH=2025-03-18
